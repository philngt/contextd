{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contextd-pack",
  "title": "contextd Pack Manifest",
  "description": "Authoring schema for contextd pack manifests v2 and v3. Runtime still accepts legacy v1 manifests during migration.",
  "type": "object",
  "required": [
    "manifest_version",
    "name",
    "version",
    "description",
    "status",
    "category",
    "reviewed_on",
    "audiences",
    "task_types",
    "scope_includes",
    "scope_excludes",
    "components",
    "keywords",
    "files",
    "conflicts_with"
  ],
  "properties": {
    "manifest_version": {
      "enum": [2, 3]
    },
    "name": {
      "type": "string",
      "pattern": "^pack-[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 40
    },
    "status": {
      "enum": ["stable", "beta", "experimental", "deprecated"]
    },
    "category": {
      "enum": [
        "agent-runtime",
        "design",
        "developer-tooling",
        "enablement",
        "engineering",
        "operations",
        "product",
        "quality",
        "security"
      ]
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["engineering", "product", "ba", "qc", "security", "design", "ops", "domain"]
      }
    },
    "task_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["implement_feature", "fix_bug", "design", "incident", "review"]
      }
    },
    "scope_includes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "scope_excludes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "keywords": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 3,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "retrieval": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "conflicts_with": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "absorbed": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "manifest_version": { "const": 2 }
        }
      },
      "then": {
        "properties": {
          "files": {
            "required": [
              "constraints",
              "coding_rules",
              "validator_rules",
              "validator_script",
              "retrieval_map",
              "prompt_overrides",
              "common_pitfalls"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "manifest_version": { "const": 3 }
        }
      },
      "then": {
        "required": ["retrieval"],
        "properties": {
          "files": {
            "required": ["knowledge", "validator_script"]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
