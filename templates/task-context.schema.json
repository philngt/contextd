{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contextd-task-context",
  "title": "contextd Task Context",
  "description": "Deterministic, file-backed context artifact for a single agent task.",
  "type": "object",
  "required": [
    "artifact_type",
    "version",
    "generated_at",
    "task",
    "workspace",
    "knowledge_root",
    "intent",
    "referenced_docs",
    "gaps",
    "warnings",
    "synapse",
    "context_projection",
    "contextPack",
    "retrieval_policy",
    "source_hashes"
  ],
  "properties": {
    "artifact_type": {
      "const": "contextd_task_context.v1"
    },
    "version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "task": {
      "type": "string"
    },
    "workspace": {
      "type": "string"
    },
    "project_dir": {
      "type": ["string", "null"]
    },
    "knowledge_root": {
      "type": "string"
    },
    "intent": {
      "type": "object",
      "required": ["type", "components", "patterns_needed", "contracts_touched"],
      "properties": {
        "type": {
          "enum": ["implement_feature", "fix_bug", "design", "incident", "review"]
        },
        "workstream": {
          "enum": [
            "engineering",
            "product",
            "business_analysis",
            "quality",
            "security",
            "design",
            "ops",
            "domain_research"
          ]
        },
        "audience": {
          "enum": ["engineering", "product", "ba", "qc", "security", "design", "ops", "domain"]
        },
        "context_goal": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": { "type": "string" }
        },
        "domain": {
          "type": ["string", "null"]
        },
        "scope": {
          "type": ["string", "null"]
        },
        "patterns_needed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "contracts_touched": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "referenced_docs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "path", "sections", "content", "source_hash"],
        "properties": {
          "category": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sections": {
            "type": "array",
            "items": { "type": "string" }
          },
          "content": {
            "type": "string"
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "synapse": {
            "$ref": "#/definitions/synapseState"
          },
          "oes_evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/oesEvidence" }
          },
          "synapse_expansion": {
            "type": "object",
            "properties": {
              "reason": { "const": "active_replacement" },
              "replaces": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "static_context": {
      "type": "array",
      "description": "Deterministic non-volatile sources materialized into context packs, including workspace profile/overrides, engine guidance, and active pack component guidance.",
      "items": {
        "type": "object",
        "required": ["category", "path", "sections", "content", "source_hash"],
        "properties": {
          "category": { "type": "string" },
          "path": { "type": "string" },
          "sections": {
            "type": "array",
            "items": { "type": "string" }
          },
          "content": { "type": "string" },
          "source_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "synapse": { "$ref": "#/definitions/synapseState" },
          "oes_evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/oesEvidence" }
          }
        },
        "additionalProperties": true
      }
    },
    "coverage": {
      "type": "object",
      "description": "Support present in selected context. Literal matches and graph routes never prove complete task coverage or corpus-wide absence.",
      "required": ["status", "query_terms", "matched_terms", "unmatched_terms", "selected_paths", "graph", "complete"],
      "properties": {
        "status": { "enum": ["no_match", "lexical_match", "declared_route", "evidence_match", "unassessed"] },
        "query_terms": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "matched_terms": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "unmatched_terms": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "selected_paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "graph": {
          "type": "object",
          "required": ["status", "matched_node_ids", "matched_edge_ids"],
          "properties": {
            "status": { "enum": ["not_requested", "no_match", "matched", "not_selected"] },
            "matched_node_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "matched_edge_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "complete": { "const": false }
      },
      "additionalProperties": false
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "missing", "blocking_hint"],
        "properties": {
          "category": { "type": "string" },
          "missing": { "type": "string" },
          "blocking_hint": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "oes": {
      "type": "object",
      "description": "Optional task-scoped selection from an OES graph validated against the retained workspace source snapshot.",
      "required": [
        "graph_path", "graph_hash", "graph_id", "template", "ontology_version",
        "validation", "matched_node_ids", "matched_edge_ids"
      ],
      "properties": {
        "graph_path": { "type": "string", "minLength": 1 },
        "graph_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "graph_id": { "type": "string", "minLength": 1 },
        "template": { "type": "string", "minLength": 1 },
        "ontology_version": { "type": ["string", "null"] },
        "matched_node_ids": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "matched_edge_ids": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "validation": {
          "type": "object",
          "required": ["structural", "evidence", "checked", "skipped"],
          "properties": {
            "structural": { "const": "passed" },
            "evidence": { "const": "passed" },
            "checked": { "type": "integer", "minimum": 0 },
            "skipped": { "const": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "synapse": {
      "type": "object",
      "required": [
        "artifact_type", "version", "policy_version", "synapse_hash",
        "as_of", "ref", "status", "summary"
      ],
      "properties": {
        "artifact_type": { "const": "contextd_synapse_ref.v1" },
        "version": { "const": "1" },
        "policy_version": { "const": "synapse-lifecycle.v1" },
        "synapse_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "as_of": { "type": "string", "format": "date" },
        "ref": { "type": ["string", "null"] },
        "status": { "enum": ["not_materialized", "materialized", "drifted"] },
        "summary": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "context_projection": {
      "type": "object",
      "required": [
        "artifact_type", "version", "memory_class", "source_synapse_hash",
        "policy_version", "selected_node_ids", "selected_states", "edges"
      ],
      "properties": {
        "artifact_type": { "const": "contextd_context_projection.v1" },
        "version": { "const": "1" },
        "memory_class": { "const": "context" },
        "source_synapse_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "policy_version": { "const": "synapse-lifecycle.v1" },
        "selected_node_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "selected_states": {
          "type": "array",
          "items": { "$ref": "#/definitions/synapseState" }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "source", "target"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "source": { "type": "string" },
              "target": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "contextPack": {
      "type": "object",
      "required": ["artifact_type", "version", "kind", "packKey", "sourceHash", "status"],
      "properties": {
        "artifact_type": { "const": "context_pack_ref" },
        "version": { "type": "string" },
        "identity_version": { "const": 2 },
        "packs": { "type": "array", "items": { "type": "string" } },
        "kind": { "type": "string" },
        "packKey": { "type": "string" },
        "ref": { "type": ["string", "null"] },
        "compiledRef": { "type": ["string", "null"] },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "category", "source_hash"],
            "properties": {
              "path": { "type": "string" },
              "category": { "type": "string" },
              "source_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": true
          }
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": { "type": "string" }
      },
      "additionalProperties": true
    },
    "decision_context": {
      "type": "object",
      "required": [
        "version",
        "request",
        "packs",
        "enabled_packs",
        "unprofiled_packs",
        "execution",
        "selection_basis"
      ],
      "properties": {
        "version": {
          "const": "1"
        },
        "execution": {
          "const": "direct-unless-required-by-contract"
        },
        "selection_basis": {
          "const": "author-profile-and-explicit-request; not model self-confidence"
        },
        "enabled_packs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unprofiled_packs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "request": {
          "type": "object",
          "required": [
            "detail",
            "foundations",
            "procedures"
          ],
          "properties": {
            "detail": {
              "enum": [
                "decision-first",
                "full"
              ]
            },
            "foundations": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^pack-[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
              }
            },
            "procedures": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^pack-[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
              }
            }
          },
          "additionalProperties": false
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pack",
              "loaded",
              "deferred",
              "estimated_tokens_full",
              "estimated_tokens_selected"
            ],
            "properties": {
              "pack": {
                "type": "string"
              },
              "estimated_tokens_full": {
                "type": "integer",
                "minimum": 1
              },
              "estimated_tokens_selected": {
                "type": "integer",
                "minimum": 1
              },
              "loaded": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "ref",
                    "kind",
                    "reason"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "foundations",
                        "procedures"
                      ]
                    },
                    "reason": {
                      "enum": [
                        "explicit-request",
                        "full-detail",
                        "on-demand"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "deferred": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "ref",
                    "kind",
                    "reason"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "foundations",
                        "procedures"
                      ]
                    },
                    "reason": {
                      "enum": [
                        "explicit-request",
                        "full-detail",
                        "on-demand"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "retrieval_policy": {
      "type": "object",
      "required": ["mode", "advisory_retrieval", "priority", "max_docs"],
      "properties": {
        "mode": { "type": "string" },
        "advisory_retrieval": { "type": "boolean" },
        "priority": {
          "type": "array",
          "items": { "type": "string" }
        },
        "max_docs": { "type": "integer" },
        "rag_policy": { "type": "string" },
        "lifecycle_policy": {
          "type": "object",
          "required": ["version", "score_adjustments", "replacement_traversal_depth"],
          "properties": {
            "version": { "const": "synapse-lifecycle.v1" },
            "score_adjustments": {
              "type": "object",
              "additionalProperties": { "type": "integer" }
            },
            "replacement_traversal_depth": { "const": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "budget_report": {
      "type": "object",
      "description": "Deterministic, model-neutral estimate for referenced, static, retrieval diagnostics, and deduplicated total context.",
      "properties": {
        "estimator": { "type": "string" },
        "max_docs": { "type": "integer" },
        "considered_docs": { "type": "integer" },
        "selected_docs": { "type": "integer" },
        "static_docs": { "type": "integer" },
        "compiled_docs": { "type": "integer" },
        "deduplicated_overlap_docs": { "type": "integer" },
        "dropped_docs": { "type": "integer" },
        "estimated_tokens_selected": { "type": "integer" },
        "estimated_tokens_referenced": { "type": "integer" },
        "estimated_tokens_static": { "type": "integer" },
        "estimated_tokens_diagnostics": { "type": "integer", "minimum": 0 },
        "estimated_tokens_total": { "type": "integer" },
        "estimated_tokens_by_category": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "estimated_tokens_static_by_category": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "estimated_tokens_total_by_category": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "category_budgets": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "used_by_category": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "drops_by_reason": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        }
      },
      "additionalProperties": true
    },
    "governance_report": {
      "type": "object",
      "description": "Optional policy-as-code report for the selected task context.",
      "properties": {
        "artifact_type": { "const": "contextd_governance_report.v1" },
        "status": { "enum": ["ok", "warning", "error"] },
        "policy_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "rule_count": { "type": "integer" }
            },
            "additionalProperties": true
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": true
        },
        "violations": {
          "type": "array",
          "items": { "type": "object" }
        },
        "load_errors": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "additionalProperties": true
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "materialized": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "definitions": {
    "oesNode": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "name": { "type": "string" },
        "title": { "type": "string" },
        "statement": { "type": "string" },
        "summary": { "type": "string" },
        "status": { "type": "string" },
        "model": { "type": "string" },
        "verification": { "type": "string" },
        "scope": { "type": "string" },
        "review": { "type": "string" },
        "freshness": { "type": "string" }
      },
      "additionalProperties": false
    },
    "oesEvidence": {
      "type": "object",
      "description": "Preserved OES assertion and evidence identity; a matched source excerpt does not establish the assertion's truth.",
      "required": [
        "graph_id", "graph_hash", "template", "edge_id", "relation",
        "from_node", "to_node", "assertion_status", "matched_node_ids",
        "evidence_id", "source_id", "source_path", "source_hash", "locator",
        "excerpt", "evidence_check"
      ],
      "properties": {
        "graph_id": { "type": "string", "minLength": 1 },
        "graph_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "template": { "type": "string", "minLength": 1 },
        "edge_id": { "type": "string", "minLength": 1 },
        "relation": { "type": "string", "minLength": 1 },
        "relation_properties": { "type": "object", "additionalProperties": true },
        "from_node": { "$ref": "#/definitions/oesNode" },
        "to_node": { "$ref": "#/definitions/oesNode" },
        "assertion_status": { "enum": ["asserted", "verified", "inferred", "hypothesis"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "valid_from": { "type": "string" },
        "valid_to": { "type": "string" },
        "matched_node_ids": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_id": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "locator": { "type": "string", "pattern": "^L[1-9][0-9]*(-L[1-9][0-9]*)?$" },
        "excerpt": { "type": "string", "minLength": 1 },
        "evidence_check": { "const": "matched" },
        "redacted": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "synapseState": {
      "type": "object",
      "required": [
        "node_id", "memory_class", "lifecycle", "freshness", "review_by"
      ],
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "memory_class": { "const": "long_term" },
        "lifecycle": { "enum": ["draft", "active", "deprecated", "superseded"] },
        "freshness": { "enum": ["fresh", "stale", "unknown"] },
        "review_by": { "type": ["string", "null"], "format": "date" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
